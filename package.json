{
  "name": "clinic-platform",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.include=\"packages/*/src/**\" --coverage.exclude=\"**/*.d.ts\" --coverage.thresholds.lines=90 --coverage.thresholds.statements=90 --coverage.thresholds.functions=90 --coverage.thresholds.branches=75",
    "test:coverage:apps": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.include=\"apps/api/src/**\" --coverage.exclude=\"**/*.module.ts\" --coverage.exclude=\"**/main.ts\" --coverage.exclude=\"**/*.d.ts\" --coverage.thresholds.lines=60 --coverage.thresholds.statements=60 --coverage.thresholds.functions=55 --coverage.thresholds.branches=60",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern \"tooling/boundary-fixtures/**\"",
    "db:migrate": "node packages/db/scripts/migrate.mjs up",
    "db:rollback": "node packages/db/scripts/migrate.mjs down",
    "db:seed": "node packages/db/scripts/migrate.mjs seed",
    "db:seed:permissions": "node packages/db/scripts/seed-permissions.mjs",
    "test:boundaries": "node tooling/boundary-fixtures/boundary.test.mjs",
    "assert:pinned": "node tooling/scripts/assert-pinned-versions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.9",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
